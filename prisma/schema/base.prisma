enum Chain {
    ARBITRUM
    AVALANCHE
    BASE
    FANTOM
    GNOSIS
    HYPEREVM
    MAINNET
    OPTIMISM
    POLYGON
    PLASMA
    SEPOLIA
    SWELLCHAIN_SEPOLIA
    ZKEVM
    FRAXTAL
    MODE
    SONIC
    XLAYER
}

model PrismaLastBlockSynced {
    @@id([category, chain])

    category            PrismaLastBlockSyncedCategory
    chain               Chain       @default(MAINNET)
    blockNumber         Int
}

enum PrismaLastBlockSyncedCategory {
    POOLS
    POOLS_V3
    ADD_POOLS_V3
    FARMS
    COW_AMM_POOLS
    COW_AMM_ADD_POOLS
    COW_AMM_JOIN_EXITS
    COW_AMM_SWAPS
    SNAPSHOTS
    BPT_BALANCES_V2
    BPT_BALANCES_V3
    BPT_BALANCES_FBEETS
    BPT_BALANCES_COW_AMM
    GAUGE_BALANCES
    JOIN_EXITS_V2
    SWAPS_V2
    JOIN_EXITS_V3
    SWAPS_V3
}
